#include <stdio.h>

int main() {
    int n, i, j, min, temp, comp = 0, swaps = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int a[n];
    printf("Enter elements:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    for(i = 0; i < n-1; i++) {
        min = i;
        for(j = i+1; j < n; j++) {
            comp++;
            if(a[j] < a[min])
                min = j;
        }

        if(min != i) {
            temp = a[i];
            a[i] = a[min];
            a[min] = temp;
            swaps++;
        }

        printf("Pass %d: ", i+1);
        for(int k = 0; k < n; k++)
            printf("%d ", a[k]);
        printf("\n");
    }

    printf("Sorted Array: ");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\nComparisons: %d\nSwaps: %d", comp, swaps);
    return 0;
}

